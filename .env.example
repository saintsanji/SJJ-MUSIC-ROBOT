DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id
GUILD_ID=

# Option A: embedded NodeLink starts when the host is loopback.
# Option B: set NODELINK_HOST to an address reachable from this bot.
NODELINK_HOST=127.0.0.1
NODELINK_PORT=3000
NODELINK_PASS=your_nodelink_password
NODELINK_SECURE=false

# Used when building Docker images with embedded NodeLink enabled.
INCLUDE_NODELINK=true
NODELINK_REPOSITORY=PerformanC/NodeLink
NODELINK_REF=main
